{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "paths": {
      "*": ["../loop-app/node_modules/*"]
    },
    "typeRoots": ["../loop-app/node_modules/@types"],
    "types": ["node"]
  },
  "include": ["**/*.ts"]
}
