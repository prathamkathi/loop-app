rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /events/{eventId} {
      // Allow anyone to read only approved events (for the live home feed)
      allow read: if resource.data.status == 'approved' 
                  || (request.auth != null && request.auth.token.coordinator == true);
      
      // Allow public creation only via the Creator Portal, enforcing 'pending' initial status
      allow create: if request.auth != null
                    && request.resource.data.status == 'pending'
                    && request.resource.data.title is string
                    && request.resource.data.image is string
                    && request.resource.data.date is string
                    && request.resource.data.time is string
                    && request.resource.data.venue is string;
                    
      // Allow client-side status mutation for the Admin Cockpit (Approving/Rejecting)
      // Ensures users can only transition a document from 'pending' to 'approved' or 'rejected'
      allow update: if request.auth != null 
                    && request.auth.token.coordinator == true
                    && resource.data.status == 'pending' 
                    && (request.resource.data.status == 'approved' || request.resource.data.status == 'rejected');
                    
      // Deny direct deletion by clients
      allow delete: if false;
    }
  }
}
