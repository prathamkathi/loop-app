rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /events/{eventId} {
      // Allow anyone to read only approved events (for the live home feed)
      allow read: if resource.data.status == 'approved' 
                  || (request.auth != null && request.auth.token.coordinator == true);
      
      // Creation is a Club Studio capability: a verified coordinator only,
      // always landing in the staging queue as 'pending'.
      allow create: if request.auth != null
                    && request.auth.token.coordinator == true
                    && request.resource.data.status == 'pending'
                    && request.resource.data.title is string
                    && request.resource.data.image is string
                    && request.resource.data.date is string
                    && request.resource.data.time is string
                    && request.resource.data.venue is string;
                    
      // Allow client-side status mutation for the Admin Cockpit (approving, soft-rejecting, undoing/restoring)
      allow update: if request.auth != null 
                    && request.auth.token.coordinator == true
                    && (resource.data.status in ['pending', 'rejected', 'approved']) 
                    && (request.resource.data.status in ['pending', 'approved', 'rejected']);
                    
      allow delete: if false;
    }

    match /pulse/{document=**} {
      allow read: if true;
    }
  }
}
