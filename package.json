    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/metro-runtime": "~57.0.15",
    "@google/generative-ai": "^0.24.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "^9.2.0",
    "@sentry/react-native": "^8.25.0",
    "cloudinary": "^2.0.0",
    "expo": "~57.0.19",
    "expo-blur": "~57.0.2",
    "expo-font": "~57.0.3",
    "expo-image": "^57.0.4",
    "expo-image-picker": "~57.0.15",
    "expo-linear-gradient": "~57.0.1",
    "expo-notifications": "~57.0.17",
    "expo-splash-screen": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "firebase": "^12.18.0",
    "firebase-admin": "^12.7.0",
    "phosphor-react-native": "^3.0.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit && tsc --noEmit -p api/tsconfig.json",
    "typecheck:app": "tsc --noEmit",
    "typecheck:api": "tsc --noEmit -p api/tsconfig.json",
    "test": "node scripts/run_tests.js && /usr/bin/python3 -m unittest scraper/tests/test_completeness_gate.py",
    "build:web": "expo export -p web && node scripts/post_export_web.js",
    "scraper": "cd scraper && source venv/bin/activate && python scraper.py",
    "scraper:dry": "cd scraper && source venv/bin/activate && python scraper.py --dry-run"
  }
