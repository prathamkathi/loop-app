{
  "name": "loop-backend",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "cloudinary": "^2.0.0",
    "firebase-admin": "^12.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p api/tsconfig.json",
    "test": "node loop-app/scripts/run_tests.js && /usr/bin/python3 -m unittest loop-app/scraper/tests/test_completeness_gate.py",
    "scraper": "cd loop-app/scraper && source venv/bin/activate && python scraper.py",
    "scraper:dry": "cd loop-app/scraper && source venv/bin/activate && python scraper.py --dry-run"
  }
}
