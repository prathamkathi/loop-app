{
  "name": "loop-backend",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "cloudinary": "^2.0.0",
    "firebase-admin": "^12.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "scraper": "cd loop-app/scraper && source venv/bin/activate && python scraper.py",
    "scraper:bg": "nohup ./loop-app/scraper/run_background_scraper.sh > /dev/null 2>&1 &",
    "scraper:stop": "./loop-app/scraper/stop_background_scraper.sh",
    "scraper:logs": "tail -f ./loop-app/scraper/scraper_bg.log"
  }
}
